MCU   = atmega328p
F_CPU = 16000000UL
CC    = avr-gcc
CFLAGS = -mmcu=$(MCU) -DF_CPU=$(F_CPU) -Os -std=gnu99 -Wall -Wextra -Werror -ffunction-sections -fdata-sections -DPOLARI_PIN_CONFIG=1
LDFLAGS = -Wl,--gc-sections
