{
  "schema": "bench-topology-spec/1",
  "bench_system": "uno-light-bench",
  "title": "the light: every way to switch it",
  "object_map": "LightState_t->LightState",
  "notes": "bss-8. The same states for every Bench Solution of the UNO light bench, whatever route its firmware variant reads the button by (external interrupt on D2, pin-change interrupt on D4, a voltage on A0) or drives the LED by (a GPIO, the timer PWM, the kit's transistor). Roles resolve per Bench Solution to the Hardware Events its own firmware offers; executions resolve their isotope from the variant's route knobs. Requirements: a number is exact; an enum label is exact; 'written' means changed on the edge; 'a..b' a range; 'a|b' a set. bss-11: a node with \"expect\": \"hold\" is a FAULT EDGE - its requirements must be met and KEPT to the end of the window (what must NOT happen: a second toggle, a repeat, a stray change); the roles bounce / long-press / held / idle / release are offered beside every button's press.",
  "roles": {
    "press": "the person presses the board's pushbutton (the firmware's asserted edge or level on the button's pin)",
    "command": "a SET_LED command from a Polari screen arrives through the bridge",
    "reset": "the person presses reset: back through init",
    "period": "the telemetry period elapses: one LightState frame leaves",
    "bounce": "the person presses the button and the contact bounces (an edge train down, a hold, an edge train up)",
    "long-press": "the person holds the button well past the debounce lockout, then releases it with bounce",
    "held": "the person holds the button for the whole window and never releases it",
    "release": "the person releases the button (the line back to rest)",
    "idle": "time passes with nothing done"
  },
  "nodes": [
    {
      "slug": "on-by-button",
      "title": "light on, by the button",
      "from": "boot",
      "via": "press",
      "requirements": {
        "led_on": 1,
        "source": "button",
        "toggles": 1,
        "status": "active"
      },
      "executions": [
        {
          "atom": "apps/light.led_toggle",
          "job": "read-button"
        },
        {
          "atom": "apps/light.led_follow_state",
          "job": "drive-led"
        }
      ],
      "collaterals": [
        {
          "kind": "net-current",
          "signal": "PD6",
          "engine": "ngspice",
          "bound": "0.005..0.020",
          "source": "declared",
          "notes": "R=220 (the kit's 220 ohm series resistor, board.custom.kit_parts); the LED is the generic indicator model (a knob: measure the kit LED's Vf); bound = the UNO pin's 20 mA limit, above 5 mA to be seen lit"
        }
      ]
    },
    {
      "slug": "on-by-command",
      "title": "light on, by the command",
      "from": "boot",
      "via": "command",
      "requirements": {
        "led_on": 1,
        "source": "command",
        "toggles": 1,
        "status": "active"
      },
      "executions": [
        {
          "atom": "apps/light.apply_command",
          "job": "receive-command"
        },
        {
          "atom": "apps/light.led_follow_state",
          "job": "drive-led"
        }
      ]
    },
    {
      "slug": "off-by-button",
      "title": "light off again, by the button",
      "from": "on-by-button",
      "via": "press",
      "also_from": [
        [
          "on-by-command",
          "press"
        ]
      ],
      "requirements": {
        "led_on": 0,
        "source": "button",
        "toggles": 2
      },
      "executions": [
        {
          "atom": "apps/light.led_toggle",
          "job": "read-button"
        },
        {
          "atom": "apps/light.led_follow_state",
          "job": "drive-led"
        }
      ]
    },
    {
      "slug": "off-by-command",
