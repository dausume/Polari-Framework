  ]
 },
 "requires": {
  "modules": [
   "board",
   "scoring"
  ],
  "libraries": [],
  "engines": [
   {
    "name": "pycparser",
    "kind": "python",
    "probe": "pycparser",
    "note": "pycparser 2.21 (BSD-3-Clause) — ALREADY in the framework image (requirements.txt pins it for cffi): the atom parser runs IN the framework process, pure Python, with its bundled PLY preprocessor (pycparser.ply.cpp) and cmod's fake avr-libc headers; 0 MB added. libclang was not taken (D-cmod-1): python3-clang-19 pulls libclang-19-dev + libllvm19 (~470 MB installed) into an engine image"
   },
   {
    "name": "avr-gcc",
    "kind": "system",
    "probe": "avr-gcc",
    "note": "the measurement compile only (the Makefile's own flags + -fstack-usage, once as shipped and once -fno-inline) — board's engine, resolved through the BOARD engines seam (BOARD_ENGINES_URL → local binary → prf-board-engines:trixie → topology board.engines → refusal)"
   },
   {
    "name": "avr-nm",
    "kind": "system",
    "probe": "avr-nm",
    "note": "binutils in the same image: per-function text bytes (nm -S --size-sort); the worker's /run lists it"
   },
   {
    "name": "make",
    "kind": "system",
    "probe": "make",
    "note": "GNU make in prf-board-engines: the proof that a project builds with make ALONE, run on the rung avr-gcc runs on (a remote worker runs single engines → refused, never faked)"
   }
  ]
 },
